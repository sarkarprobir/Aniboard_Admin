 
 
<!-- Use only this one -->
<style>#sidebar {display: none;}</style>
<div class="main-content">
<div class="order__left centered">
        <div id="form-slider" class="form-slide">
            <form class="form-panel" method="post" onsubmit="return fromValid();">
         
        <!-- Login Panel -->

            
                <div class="form" style="text-align:center">
                    <img src="/Images/logo.png" alt="Logo">
                        @if (!string.IsNullOrEmpty(Model.errMsg))
                        {
                            <div class="valitation" id="invalidMsg">@Model.errMsg</div>
                        }
                        <div class="justify__space_between">
                            @if (!string.IsNullOrEmpty(Model.adminPersonUserID))
                            {
                                <input type="text" id="username" class="form-control" name="username" placeholder="Email" autocomplete="off" value="@Model.adminPersonUserID">
                            }
                            else
                            {
                                <input type="text" id="username" class="form-control" name="username" placeholder="Email" autocomplete="off">
                            }
                            
                        <div class="valitation" style="display:none;" id="invalidEmail">Enter  Your Mail id</div>
                    </div> 
                    <div class="justify__space_between  ">
                            @if (!string.IsNullOrEmpty(Model.adminPersonUserPassword))
                            {
                                <input id="userpassword" type="password" class="form-control" name="userpassword" placeholder="Password" value="@Model.adminPersonUserPassword">
                            }
                            else
                            {
                                <input id="userpassword" type="password" class="form-control" name="userpassword" placeholder="Password">
                            }
                            
                        <span toggle="#userpassword" class="fa fa-fw fa-eye field-icon toggle-password"></span>
                        <div class="valitation" style="display:none;" id="invalidPassword">Enter  Your Mail id</div>
                    </div> 
                    <div class="justify__space_between">
                        <span>
                                @if (!string.IsNullOrEmpty(Model.adminPersonUserID))
                                {
                                    <input type="checkbox" id="remember_me" name="remember_me" value="true" style="transform: scale(1.3); margin-right: 7px; margin-left: 2px;" checked>
                                }
                                else
                                {
                                    <input type="checkbox" id="remember_me" name="remember_me" value="true" style="transform: scale(1.3); margin-right: 7px; margin-left: 2px;">
                                }
                                
                            <label for="remember_me" class="remember_me">Remember Me</label>
                        </span>
                        <a class="forgot__password" id="show-forgot">Forgot Password?</a>
                    </div> 
                    <button type="submit" class="login__button">Login</button>
                </div>
          
     
        
        
    </form>
            <form class="form-panel">
                @* method="post" onsubmit="return fromValid();" *@
            <!-- Forgot Password Panel -->
         
                <div class="form" style="text-align:center">
                    <img src="/Images/logo.png" alt="Logo">
                    <h3>Reset Password</h3>
                    <input type="email" id="reset-email" class="form-control" placeholder=" Email" />
                    <button type="button" class="reset__button" onclick="sendReset()">Send Reset Link</button>
                    <br><br>
                    <a class="back-to-login" id="back-to-login">← Back to Login</a>
                </div>
            
            </form>
        </div>
    </div>
</div>

</div>
<script src="/js/pages/login.js" asp-append-version="true"></script>
