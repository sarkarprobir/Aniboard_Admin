<script>
    // Toggle submenu and close others
    function toggleSubMenu(button) {
      const parentLi = button.closest('li');
      const subMenu = parentLi.querySelector('.sub-menu');

      // Close all other submenus
      document.querySelectorAll('#sidebar li').forEach(li => {
        if (li !== parentLi) {
          li.classList.remove('active');
          const otherSubMenu = li.querySelector('.sub-menu');
          if (otherSubMenu) {
            otherSubMenu.classList.remove('show');
          }
        }
      });

      // Toggle current submenu
      subMenu?.classList.toggle('show');
      parentLi.classList.toggle('active');
    }

    // Set active state and handle clicks
    document.addEventListener("DOMContentLoaded", () => {
      const sidebar = document.getElementById('sidebar');

      // Main links
      document.querySelectorAll('#sidebar > ul > li > a').forEach(link => {
        link.addEventListener('click', function () {
          // Handled by toggleSubMenu
        });
      });

      // Submenu links
      document.querySelectorAll('.sub-menu li a').forEach(link => {
        link.addEventListener('click', function (e) {
          e.stopPropagation(); // prevent closing
          clearActiveStates();

          // Activate clicked submenu item
          this.parentElement.classList.add('active');

          // Also activate its parent menu
          const parentLi = this.closest('li').closest('.sub-menu').closest('li');
          parentLi.classList.add('active');
          parentLi.querySelector('.sub-menu').classList.add('show');
        });
      });

      // Click outside to close all
      window.addEventListener('click', function (event) {
        if (!sidebar.contains(event.target)) {
          clearActiveStates();
        }
      });

      function clearActiveStates() {
        document.querySelectorAll('#sidebar li').forEach(li => li.classList.remove('active'));
        document.querySelectorAll('.sub-menu').forEach(ul => ul.classList.remove('show'));
      }
    });
</script>
