<script id="rendered-js">
    const toggleButton = document.getElementById("toggle-btn");
    const sidebar = document.getElementById("sidebar");

    function toggleSidebar() {
        sidebar.classList.toggle("close");
        toggleButton.classList.toggle("rotate");

        closeAllSubMenus();
    }

    function toggleSubMenu(button) {
        if (!button.nextElementSibling.classList.contains("show")) {
            closeAllSubMenus();
        }

        button.nextElementSibling.classList.toggle("show");
        button.classList.toggle("rotate");

        if (sidebar.classList.contains("close")) {
            sidebar.classList.toggle("close");
            toggleButton.classList.toggle("rotate");
        }
    }

    function closeAllSubMenus() {
        Array.from(sidebar.getElementsByClassName("show")).forEach(ul => {
            ul.classList.remove("show");
            ul.previousElementSibling.classList.remove("rotate");
        });
    }
    //# sourceURL=pen.js
</script>

<script>
    // Handle submenu toggle and active state for main menu
    function toggleSubMenu(button) {
        const parentLi = button.closest('li');
        const subMenu = parentLi.querySelector('.sub-menu');

        // Toggle show class
        subMenu?.classList.toggle('show');

        // Toggle active class on parent <li>
        parentLi.classList.toggle('active');
    }

    // Set active state on click for all links
    document.addEventListener("DOMContentLoaded", () => {
        // Main links
        document.querySelectorAll('#sidebar > ul > li > a').forEach(link => {
            link.addEventListener('click', function () {
                clearActiveStates();
                this.parentElement.classList.add('active');
            });
        });

        // Submenu links
        document.querySelectorAll('.sub-menu li a').forEach(link => {
            link.addEventListener('click', function (e) {
                e.stopPropagation(); // prevent submenu closing
                clearActiveStates();

                // Activate submenu item
                this.parentElement.classList.add('active');

                // Also activate the parent <li> of the dropdown
                const parentLi = this.closest('li').closest('.sub-menu').closest('li');
                parentLi.classList.add('active');
                parentLi.querySelector('.sub-menu').classList.add('show');
            });
        });

        function clearActiveStates() {
            document.querySelectorAll('#sidebar li').forEach(li => li.classList.remove('active'));
            document.querySelectorAll('.sub-menu').forEach(ul => ul.classList.remove('show'));
        }
    });
</script>