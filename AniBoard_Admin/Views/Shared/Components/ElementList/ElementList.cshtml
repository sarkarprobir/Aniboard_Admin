
<div class="content-card">

    <table class="table-style" cellspacing="0" cellpadding="15">
        <thead>
            <tr>
                <th class="text-nowrap"><a>Thumbnail </a></th>
                <th class="text-nowrap"><a>Element Name</a></th>
                <th class="text-nowrap"><a>Category Name</a></th>
                <th class="text-nowrap"><a>Size</a></th>
                <th class="text-nowrap"><a>Action </a></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.elementcls)
            {
                <tr>
                    <td data-th="Thumbnail">
                        <img src="@Model.imagePath@item.ImageNameThumb" style="width: 60px; margin:0px; border-radius:8px;" alt="@item.ImageName" onerror="this.onerror=null; this.src='/images/no-image.png';">
                    </td>
                    <td data-th="Image Name">@item.ElementName</td>
                    <td data-th="Category Name">@item.CategoryName</td>
                    <td data-th="Size">@item.ImageW x @item.ImageH (@item.ImageSize KB)</td>
                    <td data-th="action" class="action">
                        <a class="tableIcon info-tooltip" href="#Element-Add-Edit" onclick="javascript:showaddeditelement_modal(@item.ElementId);">
                            <img src="../images/ico-edit.png" style="width:16px; margin:0px;" alt="ico-edit">
                        </a>
                        <a role="button" href="javascript:void(0);" onclick="javascript:deleteelement(@item.ElementId);">
                            <img src="../images/ico-delete.png" style="width: 16px; margin:0px;" alt="ico-edit">
                        </a>
                    </td>
                </tr>
            }

    </table>
</div>