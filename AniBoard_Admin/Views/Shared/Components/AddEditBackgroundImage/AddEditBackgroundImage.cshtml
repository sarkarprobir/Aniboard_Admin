<div class="col-md-12">
    <div class="textbox-sec">

        
        <form id="uploadForm" enctype="multipart/form-data">
            @* <div>
                <label>Display Name:</label>
                @if (!string.IsNullOrEmpty(Model.bgImage.DisplayName))
                {
                    <input type="text" name="imageName" id="imageName" value="@Model.bgImage.DisplayName" />
                }
                else
                {
                    <input type="text" name="imageName" id="imageName"  />
                }
                
            </div> *@
            <div class="inputWithIcon">
                @if (!string.IsNullOrEmpty(Model.bgImage.DisplayName))
                {
                    <input type="text" placeholder="Image name" id="imageName" name="imageName" value="@Model.bgImage.DisplayName">
                }
                else
                {
                    <input type="text" placeholder="Image name" id="imageName" name="imageName">
                }

                <i class="fa fa-user fa-lg fa-fw" aria-hidden="true"></i>
            </div>
            <div>
                <label>Select Image:</label>
                <input type="file" name="fileInput" id="fileInput" accept="image/*" required />
            </div>
            <div id="previewContainer" style="margin-top:15px; display:none;">
                <h4>Image Preview:</h4>
                <img id="previewImage" src="" alt="Preview" style="max-width:150px; border:1px solid #ccc; padding:3px;" />
                <p id="uploadStatus"></p>
            </div>
            <button type="submit" class="btn btn-primary btn-round-2">Submit</button>
            <input type="hidden" id="imageId" name="imageId" value="@Model.imageId" />
        </form>
        
        
        
        @* <button class="btn btn-primary btn-round-2" onclick="javascript:savebackgroundimagedata();">Submit</button> *@
        
    </div>
</div>
