<div class="container" style="padding:15px;">
    <div class="row">
        <div class="col-md-12 mb-2">

            <h2 class="title">
                Elements
            </h2>
            <div class="form-group search-all">
                @if (!string.IsNullOrEmpty(Model.q))
                {
                    <input type="text" class="form-control" placeholder="Search" id="element_search" value="@Model.q">
                }
                else
                {
                    <input type="text" class="form-control" placeholder="Search" id="element_search">
                }
                <button onclick="javascript:searchelement();">
                    <span class="fa fa-search form-control-feedback"></span>
                </button>
            </div>
        </div>
    </div>
    <div class="row" style="justify-content: right;">
        <div class="select">
            <select name="CategoryId" id="CategoryId">
                <option selected="" disabled="">Choose element category</option>
                @foreach (var item in Model.elementCategoriesList)
                {
                    @if (item.ElementId == Model.categoryId)
                    {
                        <option value="@item.ElementId" selected>@item.ElementName</option>
                    }
                    else
                    {
                        <option value="@item.ElementId">@item.ElementName</option>
                    }
                }
            </select>
        </div>

        <a class="btn btn-primary search-add" href="#Element-Add-Edit" onclick="javascript:showaddeditelement_modal(0);" style="width: auto;
                line-height:30px;  margin-left: 25px; margin-right: 14px;"> + Add Element </a>
        
    </div>
    
    <div class="row mt-1">
        <div class="col-md-12 Mail-content-add-edit" id="elementlisttable">
            @await Component.InvokeAsync("ElementList", new { q = Model.q, categoryId = Convert.ToString(Model.categoryId) })
            
        </div>
        @* @if (!string.IsNullOrEmpty(Model.paginationHtml))
        { *@
            @* <div class="pagination">
                <ul class="pagination pagination-sm">
                    @Html.Raw(Model.paginationHtml)
                    
                    <li class="page-item numberbox" style="border-radius:0 !important">
                        <input type="number" id="userPageInput" class="form-control" min="1" style="width: 67px;height: 32px;" max="@Model.totalCount" value="1" onchange="javascript:pageInput();" fdprocessedid="eztwqn">
                    </li>
                </ul>
            </div> *@
        @* } *@

        <!--		Start Pagination -->
        <div class='pagination-container'>
            <nav>
                <ul class="pagination">

                    <li data-page="prev" class="p-prev">
                        <span> ← <span class="sr-only">(current)</span></span>
                    </li>
                    <!--	Here the JS Function Will Add the Rows -->
                    <li data-page="next" id="prev" class="p-next">
                        <span> → <span class="sr-only">(current)</span></span> 
                    </li>
                    <div class="count">
                        <input type="number" class="page-count-serial" id="userPageInput" value="1" @* onkeydown="javascript:pageInput(event);" *@>
                    </div>
                </ul>
            </nav>
        </div>

    </div>
</div>
<input type="hidden" id="hd_totalCount" value="@Model.totalCount" />
<input type="hidden" id="hd_rowsPerpage" value="@Model.rowsPerpage" />  
<div id="Element-Add-Edit" class="modal">
    <div class="modal__content ">
        <h2 class="mb-4 ">Element</h2>
        <div id="element_body"></div>
        <a href="#" class="modal__close">×</a>
    </div>
</div>
<script src="~/js/pages/elements.js" asp-append-version="true"></script>

