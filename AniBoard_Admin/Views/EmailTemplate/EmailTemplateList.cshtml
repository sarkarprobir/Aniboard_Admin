<div class="container" style="padding:15px;">
    <div class="row">
        <div class="col-md-12 mb-2">

            <h2 class="title">
              Email Content
            </h2>
            <div class="form-group search-all">
                @if (!string.IsNullOrEmpty(Model.q))
                {
                    <input type="text" class="form-control" placeholder="Search" id="emailtemplate_search" value="@Model.q">
                }
                else
                {
                    <input type="text" class="form-control" placeholder="Search" id="emailtemplate_search">
                }
                
                <button onclick="javascript:searchemailtemplate();">
                    <span class="fa fa-search form-control-feedback"></span>
                </button>
            </div>
        </div>
    </div>
    <div class="row">
     
        <div class="col-md-12">
            <a class="btn btn-primary search-add" href="#Email-Add-Edit" onclick="javascript:showaddedittemplate_modal(0);">+ Add Email Content</a>
        </div>
    </div>

    <div class="row mt-1">
        <div class="col-md-12 Mail-content-add-edit">
            <div class="content-card">
                <table class="table-style" cellspacing="0" cellpadding="15">
                    <thead>
                        <tr>
                            <th class="text-nowrap"><a>Template Code </a></th>
                            <th class="text-nowrap"><a>Heading</a></th>
                            <th class="text-nowrap"><a>Remarks</a></th>
                            <th class="text-nowrap"><a>Email Order</a></th>
                            <th class="text-nowrap"><a>Status </a></th>
                            <th class="text-nowrap"><a>Action </a></th>
                        </tr>
                    </thead>
                    
                    <tbody>
                        @foreach (var item in Model.emailTemplates)
                        {
                            <tr>
                                <td data-th="Template ID">@item.TemplateCode</td>
                                <td data-th="Heading">@item.Heading</td>
                                <td data-th="Remarks">@item.Remarks</td>
                                <td data-th="Email Order">@item.TemplateOrder</td>
                                <td data-th="Status">@item.IsActive</td>
                                <td data-th="Action" class="action">
                                    <a class="tableIcon info-tooltip" href="#Email-Add-Edit" onclick="javascript:showaddedittemplate_modal(@item.TemplateId);">
                                        <img src="~/images/ico-edit.png" style="width:16px; margin:0px;" alt="ico-edit">
                                    </a>
                                    <a role="button" href="javascript:void(0);" onclick="javascript:deleteemailtemplate(@item.TemplateId);">
                                        <img src="~/images/ico-delete.png" style="width: 16px; margin:0px;" alt="ico-delete">
                                    </a>
                                </td>
                            </tr>
                        }
                        
                    </tbody>
                </table>
                @* <div class="pagination">
                    <ul class="pagination pagination-sm">
                        <li class="page-item active"><span class="page-link">1</span></li>
                        <li class="page-item"><a class="page-link" href="">2</a></li>
                        <li class="page-item"><a class="page-link" href=""><span>❯</span></a></li>
                        <li class="page-item"><a class="page-link" href=""><span>❯❯</span></a></li>
                        <li class="page-item numberbox" style="border-radius:0 !important">
                            <input type="number" id="userPageInput" class="form-control" min="0" style="width: 67px;height: 32px;" max="2" value="1" fdprocessedid="eztwqn"></li>
                            </ul>
                </div> *@
            </div>
        </div>
    </div>

 
</div>

<div id="Email-Add-Edit" class="modal">
    <div class="modal__content ">
        <h2 class="mb-4 ">Email Content</h2>
        <div id="emailtemplate_body"></div>
        <a href="#" class="modal__close">×</a>
    </div>
</div>

<script src="~/js/pages/emailtemplate.js" asp-append-version="true"></script>
