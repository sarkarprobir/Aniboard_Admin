
<div class="container" style="padding:15px;">

    <div class="row">
        <div class="col-md-12 mb-2">

            <h2 class="title">User List </h2>

            <div class="form-group search-all">
                <input type="text" class="form-control" placeholder="Search" id="user_search" value="@Model.q">
                <button onclick="javascript:searchuser();">
                    <span class="fa fa-search form-control-feedback"></span>
                </button>
                </div>
        </div>
    </div>
    <div class="row ">
        <div class="col-md-12 body-top-sec">
            <div class="box-content">
                <div class="row">
                  
                    <div class="col-md-12">
                        <a class="btn btn-primary search-add" href="#User-modal" onclick="javascript:showaddedit_modal('');"> + Add User</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mt-1">
            <div class="content-card">
                <table class="table-style" cellspacing="0" cellpadding="15">
                    <thead>
                        <tr>
                            <th class="text-nowrap"><a>First Name</a></th>
                            <th class="text-nowrap"><a>Last Name</a></th>
                            <th class="text-nowrap"><a>Email </a></th>
                            <th class="text-nowrap"><a>Phone </a></th>
                            <th class="text-nowrap"><a>Country </a></th>
                            <th class="text-nowrap"><a>Status </a></th>
                            <th class="text-nowrap"><a>Action </a></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.user)
                        {
                            <tr>
                                <td class="text-nowrap"><a>@item.FirstName</a></td>
                                <td class="text-nowrap"><a>@item.LastName</a></td>
                                <td class="text-nowrap"><a>@item.Email</a></td>
                                <td class="text-nowrap"><a>@item.PhoneNumber</a></td>
                                <td class="text-nowrap"><a>@item.Country</a></td>
                                <td class="text-nowrap"><a>@item.IsActive </a></td>
                                <td class="text-nowrap"><a href="#User-modal" onclick="javascript:showaddedit_modal('@item.CustomerId');"><img style="width:18px; margin-right:10px;" src="/Images/ico-edit.png" alt=""></a> <a href="javascript:void(0);" onclick="javascript:deleteadminuser('@item.CustomerId');"><img style="width:18px;" src="/Images/ico-delete.png" alt=""></a> </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<div id="User-modal" class="modal">
    <div class="modal__content">
        <h2>User</h2>
        <div id="user_body"></div>
        <a href="#" class="modal__close">&times;</a>
    </div>
</div>
<script src="/js/pages/user.js" asp-append-version="true"></script>
